---
import '../styles.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { loadPublicConfig, jsonLdOpeningHours, whatsappE164 } from '../lib/public-config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = 'Chill Burguer Grill — Hamburguesas smash a la parrilla',
  description = 'Hamburguesas smash, guarniciones y bebidas. Pedí online con delivery en Lanús y alrededores o retiro en local: MercadoPago, transferencia o efectivo.',
  image,
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://chillburguergrill.com');
const canonical = new URL(Astro.url.pathname, site).toString();
const defaultOgImage = new URL('/images/og.png', site).toString();
const imageIsRaster = !!image && !/\.svg$/i.test(image ?? '');
const ogImage = imageIsRaster ? new URL(image!, site).toString() : defaultOgImage;

// 1 sola query D1 por request, compartida con Footer/página (ver lib/public-config).
const { contact, hours } = await loadPublicConfig(Astro.locals);

const openingHours = jsonLdOpeningHours(hours);
const addressLine = contact?.address?.trim();
const telephone = whatsappE164(contact?.whatsapp) ?? contact?.phone;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: 'Chill Burguer Grill',
  url: site.toString(),
  image: defaultOgImage,
  description,
  servesCuisine: 'Hamburguesas',
  priceRange: '$$',
  ...(telephone ? { telephone } : {}),
  ...(contact?.email ? { email: contact.email } : {}),
  ...(addressLine ? { address: { '@type': 'PostalAddress', streetAddress: addressLine, addressLocality: 'Buenos Aires', addressCountry: 'AR' } } : {}),
  ...(openingHours.length ? { openingHoursSpecification: openingHours } : {}),
  hasMenu: new URL('/menu', site).toString(),
  acceptsReservations: false,
};

const robots = noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:site_name" content="Chill Burguer Grill" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer contact={contact} hours={hours} />
  </body>
</html>

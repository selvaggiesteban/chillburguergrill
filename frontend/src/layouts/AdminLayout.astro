---
import '../styles.css';

interface Props {
  title?: string;
}

const { title = 'Panel — Chill Burguer Grill' } = Astro.props;
const pathname = Astro.url.pathname;

const links = [
  { href: '/admin', label: 'Dashboard', exact: true },
  { href: '/admin/pedidos', label: 'Pedidos', exact: false },
  { href: '/admin/carta', label: 'Carta', exact: false },
  { href: '/admin/config', label: 'Configuración', exact: false },
];

const isActive = (href: string, exact: boolean) =>
  exact ? pathname === href : pathname === href || pathname.startsWith(`${href}/`);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700;800;900&display=swap"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-slate-100 text-slate-800">
    <div class="flex min-h-screen flex-col md:flex-row">
      <aside
        class="sticky top-0 z-40 flex w-full flex-col border-b border-slate-200 bg-white px-4 py-3 md:min-h-screen md:w-56 md:py-6"
      >
        <div class="flex items-center justify-between">
          <a href="/admin" aria-label="Ir al panel">
            <img src="/images/logo.webp" alt="Chill Burguer Grill" class="h-12 w-auto" />
          </a>
          <button
            type="button"
            id="menu-toggle"
            class="rounded-lg p-2 text-slate-600 transition hover:bg-slate-100 md:hidden"
            aria-label="Abrir menú"
            aria-expanded="false"
            aria-controls="admin-menu"
          >
            <svg
              class="h-6 w-6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
        </div>

        <div id="admin-menu" class="hidden flex-1 flex-col pt-3 md:mt-12 md:flex md:pt-0">
          <nav class="flex flex-col gap-1">
            {
              links.map((link) => (
                <a
                  href={link.href}
                  class:list={[
                    'flex items-center rounded-lg px-3 py-2 text-sm font-semibold transition',
                    isActive(link.href, link.exact)
                      ? 'bg-black text-white'
                      : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900',
                  ]}
                >
                  <span>{link.label}</span>
                </a>
              ))
            }
          </nav>

          <div class="mt-auto flex flex-col gap-1">
            <a
              href="/"
              target="_blank"
              class="rounded-lg px-3 py-2 text-sm font-semibold text-slate-500 transition hover:bg-slate-100"
            >
              Ver sitio
            </a>
            <button
              type="button"
              id="logout-btn"
              class="rounded-lg px-3 py-2 text-left text-sm font-semibold text-red-600 transition hover:bg-red-50"
            >
              Cerrar sesión
            </button>
          </div>
        </div>
      </aside>

      <main class="flex-1 p-4 md:p-8">
        <slot />
      </main>
    </div>

    <script>
      document.getElementById('logout-btn')?.addEventListener('click', async () => {
        await fetch('/api/auth/logout', { method: 'POST' }).catch(() => {});
        window.location.href = '/admin/login';
      });

      const menuBtn = document.getElementById('menu-toggle');
      const menu = document.getElementById('admin-menu');
      menuBtn?.addEventListener('click', () => {
        const open = menu?.classList.toggle('flex') ?? false;
        menu?.classList.toggle('hidden', !open);
        menuBtn.setAttribute('aria-expanded', String(open));
        menuBtn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      });
    </script>
  </body>
</html>

---
import { formatSchedule, type ContactConfig, type HoursConfig } from '../lib/public-config';

interface Props {
  contact: ContactConfig | null;
  hours: HoursConfig | null;
}

const { contact, hours } = Astro.props;
const year = new Date().getFullYear();

const whatsapp = contact?.whatsapp?.trim() ?? '';
const whatsappDigits = whatsapp.replace(/\D/g, '');
const whatsappHref = whatsappDigits
  ? `https://wa.me/${whatsappDigits.startsWith('54') ? whatsappDigits : `54${whatsappDigits}`}`
  : null;

const instagramHandle = contact?.instagram?.trim().replace(/^@/, '') ?? '';
const instagramHref = instagramHandle ? `https://instagram.com/${instagramHandle}` : null;
const address = contact?.address?.trim() ?? '';
const addressHref = contact?.address_url?.trim() || null;
const email = contact?.email?.trim() ?? '';
const schedule = formatSchedule(hours);
---

<footer class="mt-16 border-t border-ink-800/10 bg-white">
  <div class="wrap grid gap-8 py-10 sm:grid-cols-3">
    <div>
      <img src="/images/logo.webp" alt="Chill Burguer Grill" width="512" height="512" class="h-20 w-auto" />
      <p class="mt-3 font-display text-2xl uppercase text-brand-600">
        Chill<span class="text-ink-800">Burger</span>Grill
      </p>
      <p class="mt-2 max-w-xs text-sm text-ink-800/60">
        Hamburguesas smash, guarniciones y bebidas. Pedí online con delivery o retiro en local.
      </p>
    </div>

    <div class="text-sm">
      <p class="mb-2 font-bold uppercase tracking-wide text-ink-800/50">Encontranos</p>
      {
        address &&
          (addressHref ? (
            <a href={addressHref} target="_blank" rel="noopener noreferrer" class="block text-ink-800/70 transition hover:text-brand-600">
              {address}
            </a>
          ) : (
            <p class="text-ink-800/70">{address}</p>
          ))
      }
      <p class="mt-1 text-ink-800/70">{schedule}</p>
      {whatsappHref && (
        <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="mt-1 block text-ink-800/70 transition hover:text-brand-600">
          WhatsApp {whatsapp}
        </a>
      )}
      {instagramHref && (
        <a href={instagramHref} target="_blank" rel="noopener noreferrer" class="mt-1 block text-ink-800/70 transition hover:text-brand-600">
          @{instagramHandle}
        </a>
      )}
      {email && (
        <a href={`mailto:${email}`} class="mt-1 block text-ink-800/70 transition hover:text-brand-600">
          {email}
        </a>
      )}
    </div>

    <div class="text-sm">
      <p class="mb-2 font-bold uppercase tracking-wide text-ink-800/50">Links</p>
      <ul class="space-y-1.5">
        <li><a href="/menu" class="text-ink-800/70 transition hover:text-brand-600">Carta</a></li>
        <li><a href="/contacto" class="text-ink-800/70 transition hover:text-brand-600">Contacto</a></li>
        <li><a href="/admin" class="text-ink-800/70 transition hover:text-brand-600">Panel</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-ink-800/10 py-4 text-center text-xs text-ink-800/40">
    © {year} Chill Burguer Grill
  </div>
</footer>

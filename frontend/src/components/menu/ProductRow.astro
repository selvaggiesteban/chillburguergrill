---
import type { Product, Promotion } from '../../lib/d1';
import { bestPromoFor } from '../../lib/d1';
import { formatPrice, parseImages, coverOf } from '../../lib/utils';
import AddToCart from '../cart/AddToCart';

interface Props {
  product: Product;
  promos?: Promotion[];
  order?: number;
}

const { product, promos = [], order = 0 } = Astro.props;

const promo = bestPromoFor(promos, product.id, product.category_id, product.price);
const hasPromo = promo.discountPct > 0;
const finalPrice = promo.promoPrice;
const image = coverOf(parseImages(product.images), product.cover_index);
const soldOut = product.disponible === 0;

const cartProduct = {
  productId: product.id,
  slug: product.slug,
  name: product.name,
  image,
  basePrice: finalPrice,
};
---

<article
  class="menu-row card relative flex items-stretch gap-4 p-3 transition hover:-translate-y-0.5 hover:shadow-md"
  data-price={finalPrice}
  data-order={order}
  data-discount={hasPromo ? '1' : '0'}
  data-featured={product.destacado === 1 ? '1' : '0'}
>
  <a
    href={`/product/${product.slug}`}
    class="flex min-w-0 flex-1 flex-col justify-center gap-1 py-1 pr-14"
  >
    <div class="flex flex-wrap items-center gap-2">
      <h3 class="font-display text-lg uppercase leading-tight tracking-wide text-ink-900">
        {product.name}
      </h3>
      {product.type === 'combo' && <span class="badge-combo">Combo</span>}
      {soldOut && <span class="badge-soldout">Agotado</span>}
    </div>
    <p class="line-clamp-2 text-sm text-ink-800/60">{product.description}</p>
    <div class="mt-1 flex items-baseline gap-2">
      {hasPromo && (
        <span class="text-sm text-ink-800/40 line-through">{formatPrice(product.price)}</span>
      )}
      <span class="font-display text-xl leading-none text-brand-600">{formatPrice(finalPrice)}</span>
    </div>
  </a>

  <a
    href={`/product/${product.slug}`}
    class="relative w-28 shrink-0 self-center sm:w-32"
    aria-label={product.name}
    tabindex="-1"
  >
    <img
      src={image}
      alt={product.name}
      loading="lazy"
      class="h-28 w-28 rounded-xl object-cover sm:h-32 sm:w-32"
    />
    {hasPromo && (
      <span
        class="absolute -left-1.5 -top-1.5 rounded-md bg-[#F2AB27] px-1.5 py-0.5 text-[11px] font-bold leading-none text-ink-900 shadow"
      >
        {promo.discountPct}% OFF
      </span>
    )}
  </a>

  {
    !soldOut && (
      <div class="absolute bottom-3 right-3">
        <AddToCart product={cartProduct} icon client:visible />
      </div>
    )
  }
</article>

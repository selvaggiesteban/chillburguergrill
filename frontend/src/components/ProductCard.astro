---
import type { Product, Promotion } from '../lib/d1';
import { bestPromoFor } from '../lib/d1';
import { formatPrice, parseImages, coverOf } from '../lib/utils';
import AddToCart from './cart/AddToCart';

interface Props {
  product: Product;
  promos?: Promotion[];
}

const { product, promos = [] } = Astro.props;

const promo = bestPromoFor(promos, product.id, product.category_id, product.price);
const hasPromo = promo.discountPct > 0;
const finalPrice = promo.promoPrice;
const image = coverOf(parseImages(product.images), product.cover_index);
const soldOut = product.disponible === 0;

const cartProduct = {
  productId: product.id,
  slug: product.slug,
  name: product.name,
  image,
  basePrice: finalPrice,
};
---

<a
  href={`/producto/${product.slug}`}
  class="card group flex flex-col overflow-hidden transition hover:-translate-y-0.5 hover:shadow-lg"
>
  <div class="relative aspect-[4/3] overflow-hidden bg-brand-100">
    <img
      src={image}
      alt={product.name}
      loading="lazy"
      class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
    />
    <div class="absolute left-3 top-3 flex flex-wrap gap-1.5">
      {hasPromo && <span class="badge-promo shadow">{promo.discountPct}% OFF</span>}
      {product.type === 'combo' && <span class="badge-combo shadow">Combo</span>}
      {soldOut && <span class="badge-soldout shadow">Agotado</span>}
    </div>
  </div>

  <div class="flex flex-1 flex-col gap-2 p-4">
    <h3 class="font-display text-xl uppercase tracking-wide text-ink-800">{product.name}</h3>
    <p class="line-clamp-2 flex-1 text-sm text-ink-800/60">{product.description}</p>

    <div class="mt-2 flex items-end justify-between gap-3">
      <div>
        {hasPromo && (
          <span class="block text-sm text-ink-800/40 line-through">{formatPrice(product.price)}</span>
        )}
        <span class="font-display text-2xl text-brand-600">{formatPrice(finalPrice)}</span>
      </div>
      {!soldOut && <AddToCart product={cartProduct} compact client:visible />}
    </div>
  </div>
</a>

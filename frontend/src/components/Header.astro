---
import CartBar from './cart/CartBar';
---

<header class="sticky top-0 z-40 bg-[#4123C0] text-white">
  <div class="wrap flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex shrink-0 items-center" aria-label="Chill Burguer Grill — Inicio">
      <img src="/images/logo.webp" alt="Chill Burguer Grill" width="512" height="512" class="h-12 w-auto" />
    </a>

    <nav class="flex items-center gap-1" aria-label="Principal">
      <a href="/contacto" class="rounded-lg px-4 py-2 font-semibold text-white transition hover:bg-white/15">Contacto</a>
    </nav>

    <div class="flex items-center gap-1">
      <CartBar client:load />
    </div>
  </div>
</header>

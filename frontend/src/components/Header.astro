---
import CartBar from './cart/CartBar';
import NotificationsBell from './notifications/NotificationsBell';
---

<header class="sticky top-0 z-40 bg-[#4123C0] text-white">
  <div class="wrap flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex shrink-0 items-center" aria-label="Chill Burguer Grill — Inicio">
      <img src="/images/logo.webp" alt="Chill Burguer Grill" width="512" height="512" class="h-12 w-auto" />
    </a>

    <div class="flex items-center gap-1">
      <NotificationsBell client:load />
      <CartBar client:load />
    </div>
  </div>
</header>

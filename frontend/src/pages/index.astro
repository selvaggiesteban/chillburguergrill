---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import HeroCarousel from '../components/home/HeroCarousel.tsx';
import { listProducts, listCategories, getActivePromotions } from '../lib/d1';

const db = Astro.locals.runtime.env.DB;
// En paralelo: 3 subrequests D1 concurrentes en vez de 3 ida y vuelta.
const [{ rows: featured }, categories, promos] = await Promise.all([
  listProducts(db, { destacadosOnly: true, limit: 6 }),
  listCategories(db),
  getActivePromotions(db, new Date().toISOString()),
]);
---

<BaseLayout>
  <HeroCarousel client:load />

  <section class="wrap py-16 text-center sm:py-24">
    <p class="mb-3 text-sm font-bold uppercase tracking-[0.3em] text-brand-600">La mejor experiencia smash</p>
    <h1 class="mx-auto max-w-3xl font-display text-5xl uppercase leading-none tracking-wide text-ink-800 sm:text-7xl">
      Chill Burguer Grill
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-lg text-ink-800/60">
      Hamburguesas smash, guarniciones y bebidas. Pedí online con delivery o retiro en local.
    </p>
    <div class="mt-7 flex flex-wrap justify-center gap-3">
      <a href="/menu" class="btn-primary px-7 py-3">Ver la carta</a>
      <a href="/contacto" class="btn-secondary px-7 py-3">Contactanos</a>
    </div>
  </section>

  {
    categories.length > 0 && (
      <section class="wrap pb-12">
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
            {categories.map((category) => (
              <a
                href={`/menu#${category.slug}`}
                class="card group relative overflow-hidden transition hover:-translate-y-1 hover:shadow-xl"
              >
                <div class="aspect-[4/3] overflow-hidden bg-brand-50">
                  <img
                    src={`/images/menu/categories/${category.slug}.webp`}
                    alt=""
                    loading="lazy"
                    class="h-full w-full object-cover transition duration-500 group-hover:scale-110"
                    onerror={`this.dataset.fb ? (this.onerror=null, this.src='/images/menu/default.svg') : (this.dataset.fb=1, this.src='/images/menu/${category.slug}.svg')`}
                  />
                </div>
                <div class="absolute inset-0 flex items-end justify-center bg-gradient-to-t from-black/60 to-transparent opacity-0 transition-opacity group-hover:opacity-100">
                   <span class="mb-4 rounded-full bg-brand-600 px-4 py-1 text-xs font-bold text-white uppercase">Explorar</span>
                </div>
                <p class="px-4 py-4 text-center font-display text-xl uppercase tracking-wide text-ink-800 group-hover:text-brand-600">
                  {category.name}
                </p>
              </a>
            ))}
          </div>
      </section>
    )
  }

  {
    featured.length > 0 && (
      <section class="wrap pb-16">
        <div class="mb-5 flex items-baseline justify-between gap-4 border-b border-ink-800/10 pb-3">
          <h2 class="section-title">Los más pedidos</h2>
          <a href="/menu" class="text-sm font-semibold text-brand-600 transition hover:text-brand-700">
            Ver todo →
          </a>
        </div>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {featured.map((product) => (
            <ProductCard product={product} promos={promos} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

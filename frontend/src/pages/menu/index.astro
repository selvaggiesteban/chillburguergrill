---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { listProducts, listCategories } from '../../lib/d1';

const db = Astro.locals.runtime.env.DB;

// Fetch all categories and all products
const [categories, allProducts] = await Promise.all([
  listCategories(db),
  listProducts(db, { includeHidden: false })
]);

// Group products by category
const categorizedProducts = categories.map(cat => ({
  category: cat,
  products: allProducts.rows.filter(p => p.category_id === cat.id).sort((a, b) => a.orden - b.orden)
})).filter(group => group.products.length > 0);
---

<BaseLayout title="Nuestra Carta" description="Descubre las mejores hamburguesas smash de Lanús.">
  <div class="wrap py-8 sm:py-16">
    <header class="mb-12 text-center">
      <h1 class="font-display text-4xl uppercase tracking-tight text-ink-900 sm:text-6xl">
        Nuestra Carta
      </h1>
      <p class="mt-4 text-lg text-ink-800/60">Sabor real, fuego lento, smash perfecto.</p>
    </header>

    <div class="flex flex-col gap-16">
      {categorizedProducts.map(group => (
        <section class="flex flex-col gap-6">
          <div class="flex items-center justify-between px-2">
            <h2 class="font-display text-[24px] leading-none uppercase tracking-wide text-ink-900">
              {group.category.name}
            </h2>
            <div class="h-px flex-1 bg-ink-800/10 mx-4"></div>
            <a href="#" class="text-sm font-bold text-brand-600 hover:underline">Ver todos</a>
          </div>

          <div class="flex overflow-x-auto pb-6 snap-x snap-mandatory scrollbar-hide gap-5 px-2">
            {group.products.map(product => (
              <div class="snap-start shrink-0 w-[280px] sm:w-[320px]">
                <ProductCard product={product} />
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>

  <style>
    .scrollbar-hide {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .scrollbar-hide::-webkit-scrollbar {
      display: none;
    }
  </style>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import AddToCart from '../../components/cart/AddToCart';
import {
  getProductBySlug,
  getCategoryById,
  listExtrasForProduct,
  getComboItemsDetailed,
  getActivePromotions,
  bestPromoFor,
  listProducts,
  type ComboItemDetailed,
} from '../../lib/d1';
import { formatPrice, parseImages, coverOf } from '../../lib/utils';

const db = Astro.locals.runtime.env.DB;
const { slug } = Astro.params;

const product = slug ? await getProductBySlug(db, slug) : null;
if (!product) {
  return Astro.rewrite('/404');
}

// Todo en paralelo: 5 subrequests D1 concurrentes en vez de 3 tandas.
const [category, extras, promos, comboItems, relatedResult] = await Promise.all([
  getCategoryById(db, product.category_id),
  listExtrasForProduct(db, product.id),
  getActivePromotions(db, new Date().toISOString()),
  product.type === 'combo'
    ? getComboItemsDetailed(db, product.id)
    : Promise.resolve<ComboItemDetailed[]>([]),
  listProducts(db, { categoryId: product.category_id, limit: 6 }),
]);

const promo = bestPromoFor(promos, product.id, product.category_id, product.price);
const hasPromo = promo.discountPct > 0;
const finalPrice = promo.promoPrice;
const images = parseImages(product.images);
const image = coverOf(images, product.cover_index);
const soldOut = product.disponible === 0;

const related = relatedResult.rows.filter((p) => p.id !== product.id).slice(0, 3);

const cartProduct = {
  productId: product.id,
  slug: product.slug,
  name: product.name,
  image,
  basePrice: finalPrice,
};
---

<BaseLayout
  title={`${product.name} — Chill Burguer Grill`}
  description={product.description || `${product.name} en Chill Burguer Grill.`}
  image={image || undefined}
>
  <div class="wrap py-8">
    <nav class="mb-6 text-sm text-ink-800/50" aria-label="Migas de pan">
      <a href="/menu" class="transition hover:text-brand-600">Carta</a>
      <span class="mx-2">/</span>
      {category && (
        <>
          <a href={`/menu#${category.slug}`} class="transition hover:text-brand-600">{category.name}</a>
          <span class="mx-2">/</span>
        </>
      )}
      <span class="text-ink-800">{product.name}</span>
    </nav>

    <div class="grid gap-8 lg:grid-cols-2">
      <div class="relative overflow-hidden rounded-3xl bg-brand-100 shadow-sm ring-1 ring-ink-800/5">
        <img
          src={image}
          alt={product.name}
          class="aspect-[4/3] w-full object-cover"
          fetchpriority="high"
        />
        <div class="absolute left-4 top-4 flex gap-1.5">
          {hasPromo && <span class="badge-promo shadow">{promo.discountPct}% OFF</span>}
          {product.type === 'combo' && <span class="badge-combo shadow">Combo</span>}
          {soldOut && <span class="badge-soldout shadow">Agotado</span>}
        </div>
      </div>

      <div>
        <h1 class="font-display text-4xl uppercase tracking-wide text-ink-800">{product.name}</h1>

        <div class="mt-3 flex items-end gap-3">
          {hasPromo && (
            <span class="text-lg text-ink-800/40 line-through">{formatPrice(product.price)}</span>
          )}
          <span class="font-display text-4xl text-brand-600">{formatPrice(finalPrice)}</span>
          {hasPromo && promo.promoName && (
            <span class="mb-1 text-sm font-semibold text-red-600">{promo.promoName}</span>
          )}
        </div>

        {product.description && (
          <p class="mt-4 leading-relaxed text-ink-800/70">{product.description}</p>
        )}

        {comboItems.length > 0 && (
          <section class="card mt-6 p-4">
            <h2 class="mb-2 text-sm font-bold uppercase tracking-wide text-ink-800/50">
              El combo incluye
            </h2>
            <ul class="space-y-1.5 text-sm">
              {comboItems.map((item) => (
                <li class="flex items-center justify-between gap-3">
                  <a
                    href={`/menu/${item.product_slug}`}
                    class="text-ink-800/80 transition hover:text-brand-600"
                  >
                    {item.quantity > 1 && <span class="font-bold">{item.quantity}×</span>}
                    {item.product_name}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        <div class="mt-6">
          {soldOut ? (
            <div class="rounded-xl bg-ink-800/5 px-4 py-3 text-center font-semibold text-ink-800/60">
              Por momento sin stock
            </div>
          ) : (
            <AddToCart product={cartProduct} extras={extras} client:visible />
          )}
        </div>

        {extras.length > 0 && (
          <p class="mt-3 text-xs text-ink-800/40">
            Los agregados se cocinan al momento de tu pedido.
          </p>
        )}
      </div>
    </div>

    {
      related.length > 0 && (
        <section class="mt-14">
          <h2 class="section-title mb-5">También te puede gustar</h2>
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((p) => (
              <ProductCard product={p} promos={promos} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

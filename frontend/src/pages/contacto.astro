---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadPublicConfig, formatSchedule, whatsappLink } from '../lib/public-config';

const { contact, hours } = await loadPublicConfig(Astro.locals);
const schedule = formatSchedule(hours);

const whatsapp = contact?.whatsapp?.trim() ?? '';
const whatsappHref = whatsappLink(contact?.whatsapp);

const instagramHandle = contact?.instagram?.trim().replace(/^@/, '') ?? '';
const instagramHref = instagramHandle ? `https://instagram.com/${instagramHandle}` : null;
const address = contact?.address?.trim() ?? '';
const addressHref = contact?.address_url?.trim() || null;
const email = contact?.email?.trim() ?? '';
---

<BaseLayout
  title="Contacto — Chill Burguer Grill"
  description="Dirección, horarios y medios de contacto de Chill Burguer Grill: WhatsApp, Instagram y cómo llegar al local."
>
  <div class="wrap py-12">
    <header class="mb-8 text-center">
      <h1 class="section-title">Contacto</h1>
      <p class="mx-auto mt-2 max-w-xl text-ink-800/60">
        {schedule}. ¡Escribinos o pasá por el local!
      </p>
    </header>

    <div class="mx-auto grid max-w-4xl gap-5 sm:grid-cols-3">
      <div class="card p-6 text-center">
        <p class="mb-1 text-2xl">📍</p>
        <p class="text-sm font-bold uppercase tracking-wide text-ink-800/50">Dirección</p>
        {
          addressHref ? (
            <a href={addressHref} target="_blank" rel="noopener noreferrer" class="mt-1 block text-ink-800/70 transition hover:text-brand-600">
              {address}
            </a>
          ) : (
            <p class="mt-1 text-ink-800/70">{address || '—'}</p>
          )
        }
      </div>

      <div class="card p-6 text-center">
        <p class="mb-1 text-2xl">🕐</p>
        <p class="text-sm font-bold uppercase tracking-wide text-ink-800/50">Horario</p>
        <p class="mt-1 text-ink-800/70">{schedule}</p>
      </div>

      <div class="card p-6 text-center">
        <p class="mb-1 text-2xl">💬</p>
        <p class="text-sm font-bold uppercase tracking-wide text-ink-800/50">WhatsApp</p>
        {
          whatsappHref ? (
            <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="mt-1 block text-ink-800/70 transition hover:text-brand-600">
              {whatsapp}
            </a>
          ) : (
            <p class="mt-1 text-ink-800/70">{whatsapp || '—'}</p>
          )
        }
      </div>
    </div>

    <div class="mx-auto mt-5 grid max-w-4xl gap-5 sm:grid-cols-2">
      {
        instagramHref && (
          <div class="card p-6 text-center">
            <p class="mb-1 text-2xl">📸</p>
            <p class="text-sm font-bold uppercase tracking-wide text-ink-800/50">Instagram</p>
            <a href={instagramHref} target="_blank" rel="noopener noreferrer" class="mt-1 block text-ink-800/70 transition hover:text-brand-600">
              @{instagramHandle}
            </a>
          </div>
        )
      }
      {
        email && (
          <div class="card p-6 text-center">
            <p class="mb-1 text-2xl">✉️</p>
            <p class="text-sm font-bold uppercase tracking-wide text-ink-800/50">Email</p>
            <a href={`mailto:${email}`} class="mt-1 block text-ink-800/70 transition hover:text-brand-600">
              {email}
            </a>
          </div>
        )
      }
    </div>

    <div class="mt-8 text-center">
      <a href="/" class="btn-primary px-7 py-3">Hacer un pedido</a>
      <p class="mt-4 text-sm text-ink-800/60">
        <a href="/politicas-de-envios-y-devoluciones" class="transition hover:text-brand-600 hover:underline">
          Políticas de Envíos y Devoluciones →
        </a>
      </p>
    </div>
  </div>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProofUpload from '../../components/checkout/ProofUpload';
import { getOrderById, getOrderItems, getConfig, type BankConfig } from '../../lib/d1';
import { formatPrice } from '../../lib/utils';

const { id } = Astro.params;
const db = Astro.locals.runtime.env.DB;

const order = id ? await getOrderById(db, id) : null;
if (!order || !id) {
  return Astro.rewrite('/404');
}

const [items, bank] = await Promise.all([
  getOrderItems(db, id),
  order.payment_method === 'transfer' ? getConfig<BankConfig>(db, 'bank') : null,
]);

const mpMock = Astro.url.searchParams.get('mp') === 'mock';
const mpReturn = Astro.url.searchParams.get('mp');

const PAYMENT_LABELS: Record<string, { label: string; cls: string }> = {
  pending: { label: 'Pago pendiente', cls: 'bg-amber-100 text-amber-800 ring-amber-200' },
  processing: { label: 'Pago en proceso', cls: 'bg-blue-100 text-blue-800 ring-blue-200' },
  paid: { label: 'Pagado', cls: 'bg-green-100 text-green-800 ring-green-200' },
  rejected: { label: 'Pago rechazado', cls: 'bg-red-100 text-red-800 ring-red-200' },
  refunded: { label: 'Reembolsado', cls: 'bg-gray-100 text-gray-700 ring-gray-200' },
};

const STATUS_LABELS: Record<string, string> = {
  new: 'Recibido',
  confirmed: 'Confirmado',
  preparing: 'En preparación',
  ready: 'Listo para enviar',
  on_the_way: 'En camino',
  delivered: 'Entregado',
  cancelled: 'Cancelado',
};

const paymentBadge = PAYMENT_LABELS[order.payment_status] ?? PAYMENT_LABELS.pending;
const shortId = order.id.replace(/-/g, '').slice(0, 8).toUpperCase();
const hasProof = !!order.transfer_proof_key;
const needsProof = order.payment_method === 'transfer' && !hasProof && order.payment_status === 'pending';
const canPayMp =
  order.payment_method === 'mercadopago' &&
  order.payment_status !== 'paid' &&
  !!order.mp_preference_id;
---

<BaseLayout title={`Pedido ${shortId} — Chill Burguer Grill`} noindex>
  <div class="wrap max-w-3xl py-10">
    <div class="mb-6 text-center">
      <h1 class="font-display text-3xl uppercase text-ink-800 sm:text-4xl">
        ¡Gracias, {order.customer_name.split(' ')[0]}!
      </h1>
      <p class="mt-1 text-ink-800/60">
        Tu pedido <span class="font-bold text-ink-800">#{shortId}</span> fue recibido.
        {order.fulfillment === 'delivery' ? ' Lo enviamos a tu dirección.' : ' Te esperamos en el local.'}
      </p>
      <div class="mt-3 flex flex-wrap justify-center gap-2">
        <span class={`badge ${paymentBadge.cls}`}>{paymentBadge.label}</span>
        <span class="badge bg-white text-ink-800 ring-1 ring-ink-800/15">
          {STATUS_LABELS[order.status] ?? order.status}
        </span>
      </div>
    </div>

    {
      mpMock && (
        <div class="mb-6 rounded-xl bg-amber-50 px-4 py-3 text-center text-sm text-amber-800 ring-1 ring-amber-200">
          Modo desarrollo: el pago con MercadoPago se simuló sin conexión a la API real.
        </div>
      )
    }
    {
      mpReturn === 'pending' && !mpMock && (
        <div class="mb-6 rounded-xl bg-blue-50 px-4 py-3 text-center text-sm text-blue-800 ring-1 ring-blue-200">
          Volviste de MercadoPago. En cuanto se acredite el pago te lo confirmamos.
        </div>
      )
    }

    {
      canPayMp && (
        <div class="mb-6 card p-5 text-center">
          <p class="mb-3 text-ink-800/70">Tu pago con MercadoPago está pendiente.</p>
          <a href={order.mp_preference_id} class="btn-primary">Ir a pagar</a>
        </div>
      )
    }

    {
      needsProof && (
        <div class="mb-6 card p-5">
          <h2 class="mb-1 font-display text-xl uppercase text-ink-800">Pagá por transferencia</h2>
          <div class="my-3 rounded-xl bg-zinc-100 p-4 text-sm ring-1 ring-zinc-200">
            <p><span class="font-bold">Alias:</span> {bank?.alias || '—'}</p>
            <p><span class="font-bold">CBU:</span> {bank?.cbu || '—'}</p>
            <p><span class="font-bold">Titular:</span> {bank?.titular || '—'}</p>
            <p class="mt-2 text-ink-800/60">Importe: <span class="font-bold text-ink-800">{formatPrice(order.total)}</span></p>
          </div>
          <ProofUpload orderId={order.id} client:load />
        </div>
      )
    }
    {
      hasProof && order.payment_method === 'transfer' && order.payment_status === 'pending' && (
        <div class="mb-6 rounded-xl bg-green-50 px-4 py-3 text-center text-sm font-medium text-green-700">
          Comprobante recibido. Lo estamos verificando.
        </div>
      )
    }
    {
      order.payment_method === 'cash' && (
        <div class="mb-6 rounded-xl bg-zinc-100 px-4 py-3 text-center text-sm text-zinc-800 ring-1 ring-zinc-200">
          Pagás en efectivo al recibir el pedido. Si podés, prepará el importe exacto: {formatPrice(order.total)}.
        </div>
      )
    }

    <div class="card p-6">
      <h2 class="mb-4 font-display text-xl uppercase text-ink-800">Detalle</h2>
      <ul class="space-y-3">
        {
          items.map((item) => {
            const extras = JSON.parse(item.extras_json || '[]') as { name: string }[];
            return (
              <li class="flex items-start justify-between gap-3 text-sm">
                <span>
                  <span class="font-semibold text-ink-800">
                    {item.quantity}× {item.product_name}
                  </span>
                  {extras.length > 0 && (
                    <span class="block text-xs text-ink-800/50">
                      {extras.map((e) => e.name).join(' · ')}
                    </span>
                  )}
                </span>
                <span class="font-medium text-ink-800/70">{formatPrice(item.subtotal)}</span>
              </li>
            );
          })
        }
      </ul>

      <dl class="mt-4 space-y-2 border-t border-ink-800/10 pt-4 text-sm">
        <div class="flex justify-between">
          <dt class="text-ink-800/60">Subtotal</dt>
          <dd>{formatPrice(order.subtotal)}</dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-ink-800/60">{order.fulfillment === 'delivery' ? 'Envío' : 'Retiro'}</dt>
          <dd>{order.delivery_cost > 0 ? formatPrice(order.delivery_cost) : 'Sin costo'}</dd>
        </div>
        <div class="flex items-end justify-between border-t border-ink-800/10 pt-3">
          <dt class="font-bold text-ink-800">Total</dt>
          <dd class="font-display text-3xl text-black">{formatPrice(order.total)}</dd>
        </div>
      </dl>

      <div class="mt-4 grid gap-2 border-t border-ink-800/10 pt-4 text-sm text-ink-800/70">
        <p>{order.customer_phone}</p>
        {order.fulfillment === 'delivery' && <p>{order.address} {order.zone ? `(${order.zone})` : ''}</p>}
        {order.notes && <p>{order.notes}</p>}
      </div>
    </div>

    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-secondary">Seguir comprando</a>
      <button type="button" onclick="window.location.reload()" class="btn-ghost">Actualizar estado</button>
    </div>
  </div>
</BaseLayout>

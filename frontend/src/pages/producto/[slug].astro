---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductDetailView from '../../components/product/ProductDetailView';
import { getProductBySlug, listExtrasForProduct, getActivePromotions, bestPromoFor, listAdicionalSection, getPopularCustomization } from '../../lib/d1';
import { parseImages, coverOf } from '../../lib/utils';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/menu');

const db = Astro.locals.runtime.env.DB;
const product = await getProductBySlug(db, slug);

if (!product) return Astro.redirect('/menu');

const [extras, promos, adicional, popular] = await Promise.all([
  listExtrasForProduct(db, product.id),
  getActivePromotions(db, new Date().toISOString()),
  listAdicionalSection(db, product),
  getPopularCustomization(db, product.id),
]);

const promo = bestPromoFor(promos, product.id, product.category_id, product.price);

const cover = coverOf(parseImages(product.images), product.cover_index);
const seoTitle = `${product.name} | Chill Burguer Grill`;
const seoDescription = product.description?.trim() || undefined;
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image={cover}
  imageAlt={`${product.name} — foto del producto`}
  product={{ name: product.name, description: seoDescription, price: product.price, slug: product.slug, disponible: product.disponible }}
>
  <ProductDetailView
    client:load
    product={product}
    extras={extras}
    adicionalOptions={adicional.options}
    adicionalRequired={adicional.required}
    popular={popular}
    basePrice={promo.promoPrice}
    originalPrice={product.price}
    discountPct={promo.discountPct}
  />
</BaseLayout>

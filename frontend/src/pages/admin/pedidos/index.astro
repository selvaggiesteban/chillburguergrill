---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listOrders, type OrderStatus } from '../../../lib/d1';
import { formatPrice } from '../../../lib/utils';

const status = Astro.url.searchParams.get('status') ?? undefined;
const db = Astro.locals.runtime.env.DB;
const { rows, total } = await listOrders(db, { status, limit: 100 });

const filters: { label: string; value?: string }[] = [
  { label: 'Todos' },
  { label: 'Nuevos', value: 'new' },
  { label: 'Confirmados', value: 'confirmed' },
  { label: 'En preparación', value: 'preparing' },
  { label: 'Listos', value: 'ready' },
  { label: 'En camino', value: 'on_the_way' },
  { label: 'Entregados', value: 'delivered' },
  { label: 'Cancelados', value: 'cancelled' },
];

const formatDate = (iso: string) => iso.replace('T', ' ').slice(0, 16);

const PAY_BADGES: Record<string, string> = {
  pending: 'bg-amber-100 text-amber-700',
  processing: 'bg-blue-100 text-blue-700',
  paid: 'bg-green-100 text-green-700',
  rejected: 'bg-red-100 text-red-700',
  refunded: 'bg-slate-100 text-slate-600',
};
const PAY_LABELS: Record<string, string> = {
  pending: 'Pendiente',
  processing: 'En proceso',
  paid: 'Pagado',
  rejected: 'Rechazado',
  refunded: 'Reembolsado',
};
const STATUS_BADGES: Record<string, string> = {
  new: 'bg-blue-100 text-blue-700',
  confirmed: 'bg-indigo-100 text-indigo-700',
  preparing: 'bg-amber-100 text-amber-700',
  ready: 'bg-purple-100 text-purple-700',
  on_the_way: 'bg-cyan-100 text-cyan-700',
  delivered: 'bg-green-100 text-green-700',
  cancelled: 'bg-red-100 text-red-700',
};
const STATUS_LABELS: Record<string, string> = {
  new: 'Nuevo',
  confirmed: 'Confirmado',
  preparing: 'En preparación',
  ready: 'Listo',
  on_the_way: 'En camino',
  delivered: 'Entregado',
  cancelled: 'Cancelado',
};
---

<AdminLayout title="Pedidos — Chill Admin">
  <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
    <h1 class="font-display text-3xl uppercase text-slate-900">Pedidos</h1>
    <span class="text-sm text-slate-500">{total} en total</span>
  </div>

  <div class="mb-5 flex flex-wrap gap-2">
    {
      filters.map((f) => (
        <a
          href={f.value ? `/admin/pedidos?status=${f.value}` : '/admin/pedidos'}
          class:list={[
            'rounded-full px-4 py-1.5 text-sm font-semibold transition',
            (f.value ?? undefined) === status
              ? 'bg-black text-white'
              : 'bg-white text-slate-600 ring-1 ring-slate-200 hover:ring-black',
          ]}
        >
          {f.label}
        </a>
      ))
    }
  </div>

  <div class="overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-slate-200">
    {
      rows.length === 0 ? (
        <p class="p-10 text-center text-sm text-slate-500">No hay pedidos con este filtro.</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
              <tr>
                <th class="px-5 py-3">Fecha</th>
                <th class="px-5 py-3">Cliente</th>
                <th class="px-5 py-3">Entrega</th>
                <th class="px-5 py-3">Pago</th>
                <th class="px-5 py-3">Total</th>
                <th class="px-5 py-3">Estado</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {rows.map((order) => (
                <tr class="hover:bg-slate-50">
                  <td class="whitespace-nowrap px-5 py-3 text-slate-500">{formatDate(order.created_at)}</td>
                  <td class="px-5 py-3">
                    <a href={`/admin/pedidos/${order.id}`} class="font-semibold text-slate-800 hover:text-black">
                      {order.customer_name}
                    </a>
                    <span class="block text-xs text-slate-400">{order.customer_phone}</span>
                  </td>
                  <td class="px-5 py-3 text-slate-500">
                    {order.fulfillment === 'delivery' ? `Delivery · ${order.zone ?? '—'}` : 'Retiro'}
                  </td>
                  <td class="px-5 py-3">
                    <span class={`rounded-full px-2.5 py-0.5 text-xs font-bold ${PAY_BADGES[order.payment_status]}`}>
                      {PAY_LABELS[order.payment_status] ?? order.payment_status}
                    </span>
                  </td>
                  <td class="px-5 py-3 font-semibold">{formatPrice(order.total)}</td>
                  <td class="px-5 py-3">
                    <span class={`rounded-full px-2.5 py-0.5 text-xs font-bold ${STATUS_BADGES[order.status] ?? 'bg-slate-100'}`}>
                      {STATUS_LABELS[order.status] ?? order.status}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </div>
</AdminLayout>

---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import OrderControls from '../../../components/admin/OrderControls';
import { getOrderById, getOrderItems, getConfig, type BankConfig } from '../../../lib/d1';
import { formatPrice } from '../../../lib/utils';

const { id } = Astro.params;
const db = Astro.locals.runtime.env.DB;
const order = id ? await getOrderById(db, id) : null;
if (!order || !id) {
  return Astro.rewrite('/404');
}
const items = await getOrderItems(db, id);
const bank =
  order.payment_method === 'transfer' ? await getConfig<BankConfig>(db, 'bank') : null;

const shortId = order.id.replace(/-/g, '').slice(0, 8).toUpperCase();
const hasProof = !!order.transfer_proof_key;
---

<AdminLayout title={`Pedido ${shortId} — Chill Admin`}>
  <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
    <div>
      <a href="/admin/pedidos" class="text-sm font-semibold text-brand-600 hover:text-brand-700">← Pedidos</a>
      <h1 class="font-display text-3xl uppercase text-slate-900">Pedido #{shortId}</h1>
      <p class="text-sm text-slate-500">{order.created_at.replace('T', ' ').slice(0, 16)}</p>
    </div>
  </div>

  <div class="grid gap-5 lg:grid-cols-[1fr_20rem]">
    <div class="space-y-5">
      <section class="rounded-xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
        <h2 class="mb-3 font-bold text-slate-900">Detalle</h2>
        <ul class="divide-y divide-slate-100 text-sm">
          {
            items.map((item) => {
              const extras = JSON.parse(item.extras_json || '[]') as { name: string }[];
              return (
                <li class="flex items-start justify-between gap-3 py-2.5">
                  <span>
                    <span class="font-semibold text-slate-800">
                      {item.quantity}× {item.product_name}
                    </span>
                    {extras.length > 0 && (
                      <span class="block text-xs text-slate-500">
                        {extras.map((e) => e.name).join(' · ')}
                      </span>
                    )}
                  </span>
                  <span class="font-medium text-slate-600">{formatPrice(item.subtotal)}</span>
                </li>
              );
            })
          }
        </ul>
        <dl class="mt-3 space-y-1.5 border-t border-slate-100 pt-3 text-sm">
          <div class="flex justify-between">
            <dt class="text-slate-500">Subtotal</dt>
            <dd>{formatPrice(order.subtotal)}</dd>
          </div>
          <div class="flex justify-between">
            <dt class="text-slate-500">Envío</dt>
            <dd>{order.delivery_cost > 0 ? formatPrice(order.delivery_cost) : 'Sin costo'}</dd>
          </div>
          <div class="flex justify-between text-base font-bold text-slate-900">
            <dt>Total</dt>
            <dd>{formatPrice(order.total)}</dd>
          </div>
        </dl>
      </section>

      <section class="rounded-xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
        <h2 class="mb-3 font-bold text-slate-900">Cliente y entrega</h2>
        <dl class="grid gap-2 text-sm sm:grid-cols-2">
          <div><dt class="text-slate-500">Nombre</dt><dd class="font-medium">{order.customer_name}</dd></div>
          <div><dt class="text-slate-500">Teléfono</dt><dd class="font-medium">{order.customer_phone}</dd></div>
          <div><dt class="text-slate-500">Email</dt><dd class="font-medium">{order.customer_email ?? '—'}</dd></div>
          <div><dt class="text-slate-500">Entrega</dt><dd class="font-medium">{order.fulfillment === 'delivery' ? 'Delivery' : 'Retiro en local'}</dd></div>
          {order.address && <div class="sm:col-span-2"><dt class="text-slate-500">Dirección</dt><dd class="font-medium">{order.address} {order.zone ? `(${order.zone})` : ''}</dd></div>}
          {order.notes && <div class="sm:col-span-2"><dt class="text-slate-500">Aclaraciones</dt><dd class="font-medium">{order.notes}</dd></div>}
          <div><dt class="text-slate-500">Método de pago</dt><dd class="font-medium capitalize">{order.payment_method === 'cash' ? 'Efectivo' : order.payment_method === 'transfer' ? 'Transferencia' : 'MercadoPago'}</dd></div>
        </dl>

        {
          order.payment_method === 'transfer' && bank && (
            <div class="mt-4 rounded-lg bg-slate-50 p-3 text-sm ring-1 ring-slate-200">
              <p><span class="font-bold">Alias:</span> {bank.alias || '—'}</p>
              <p><span class="font-bold">CBU:</span> {bank.cbu || '—'}</p>
              <p><span class="font-bold">Titular:</span> {bank.titular || '—'}</p>
            </div>
          )
        }

        {
          hasProof && (
            <div class="mt-4">
              <p class="mb-2 text-sm font-bold text-slate-700">Comprobante de transferencia</p>
              <a href={`/api/admin/orders/${order.id}/proof`} target="_blank">
                <img
                  src={`/api/admin/orders/${order.id}/proof`}
                  alt="Comprobante de pago"
                  class="max-h-72 rounded-lg border border-slate-200 object-contain"
                />
              </a>
            </div>
          )
        }
      </section>
    </div>

    <aside class="space-y-5">
      <OrderControls
        orderId={order.id}
        status={order.status}
        paymentStatus={order.payment_status}
        client:load
      />

      {
        order.mp_preference_id?.startsWith('http') && (
          <div class="rounded-xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
            <p class="mb-2 text-xs font-bold uppercase tracking-wide text-slate-500">MercadoPago</p>
            <a href={order.mp_preference_id} target="_blank" class="text-sm font-semibold text-brand-600 hover:text-brand-700">
              Abrir preferencia ↗
            </a>
            {order.mp_payment_id && <p class="mt-1 text-xs text-slate-500">Pago: {order.mp_payment_id}</p>}
          </div>
        )
      }
    </aside>
  </div>
</AdminLayout>

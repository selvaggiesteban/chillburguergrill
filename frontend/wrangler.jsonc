{
  "name": "chillburguergrill",
  "pages_build_output_dir": "dist/",
  "compatibility_date": "2026-06-14",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chill-menu",
      "database_id": "f7e04d5c-8119-4dd6-9bc0-0fa9b9b6eff1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "chillburguergrill-images"
    }
  ],
  // Sesiones de Astro 5 (adapter la habilita automáticamente)
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "c548eb5da0f645d0a7048e9bc946342d"
    }
  ]
}
